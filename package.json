{
  "name": "opencode-ghost",
  "version": "1.3.2",
  "description": "Stateless inline next-prompt ghosts for the empty OpenCode V2 composer, accepted with Tab or Right.",
  "type": "module",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-ghost.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-ghost#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-ghost/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "ghost-text",
    "autosuggest",
    "prompt",
    "suggestion"
  ],
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "opencode": ">=2.0.25"
  },
  "scripts": {
    "prepare": "husky",
    "test": "bun test && bash tests/changelog.sh",
    "test:unit": "bun test",
    "test:changelog": "bash tests/changelog.sh",
    "typecheck": "tsc --noEmit",
    "lint:sh": "for script in install.sh tests/*.sh scripts/*.sh; do bash -n \"$script\" || exit; done",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.5.16",
    "@opentui/solid": ">=0.5.16",
    "solid-js": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opencode/plugin": "2.0.25",
    "@opentui/core": "^0.5.16",
    "@opentui/solid": "^0.5.16",
    "@types/bun": "^1.4.2",
    "@types/node": "24.12.2",
    "husky": "^9.1.7",
    "solid-js": "^1.9.12",
    "typescript": "7.0.2"
  }
}
